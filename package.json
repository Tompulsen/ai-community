{
  "name": "ai-community-next",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:design": "node tools/design-preview.mjs",
    "build": "npm run typecheck:server && vue-tsc -b && vite build",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "start": "node server/runtime.ts",
    "test:server": "node --test server/*.test.mjs",
    "test": "vitest run src/state.test.ts server/business",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.8",
    "@lucide/vue": "^1.72.0",
    "bcryptjs": "3.0.3",
    "fastify": "5.12.8",
    "figma-squircle": "1.1.0",
    "ioredis": "5.11.1",
    "nodemailer": "10.5.0",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "vue": "^3.5.44",
    "vue-router": "^5.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.20.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
