    "dompurify": "^3.4.17",
    "fastify": "5.12.8",
    "figma-squircle": "1.1.0",
    "idb-keyval": "^6.2.1",
    "ioredis": "5.11.1",
    "iron-session": "8.0.4",
    "marked": "^18.2.0",
    "nanoid": "^5.1.16",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
