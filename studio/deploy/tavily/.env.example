TAVILY_API_KEY=
# Optional comma-separated key pool. When nonempty, replaces TAVILY_API_KEY.
# Example: TAVILY_API_KEYS=tvly-your-first-key,tvly-your-second-key
TAVILY_API_KEYS=
# Generate a separate random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TAVILY_PROXY_KEY=
TAVILY_NEW_API_NETWORK=1panel-network
TAVILY_PORT=18093
