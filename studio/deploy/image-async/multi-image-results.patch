+++ b/tests/test_multi_image.py
@@ -0,0 +1,170 @@
+"""No generation calls: provider result counts and storage admission regressions."""
+import asyncio
+import base64
+import json
+from concurrent.futures import ThreadPoolExecutor
+from types import SimpleNamespace
+
+import pytest
+from fastapi.testclient import TestClient
+
+from test_service import TOKEN, PNG, owner, reset, make_job, row, set_response, fake_download, mock_sync_upstream
+from service import api, core, tasks, sync
+
+
+def test_requested_one_saves_four_without_regeneration(monkeypatch):
+    job = make_job()["id"]
+    before = row(job)["reserved"]
+    items = [{"url": f"https://upstream.example/{index}.png", "b64_json": ""} for index in range(4)]
+    set_response(job, items)
+    monkeypatch.setattr(tasks, "download", fake_download)
+    tasks.prepare_impl(job)
+    prepared = row(job)
+    assert prepared["status"] == "saving"
+    assert prepared["n"] == 1 and prepared["actual_n"] == 4
+    assert prepared["reserved"] > before
+    for index in range(4):
+        tasks.save_image.call_local(core.image_id(job, index))
+    finished = row(job)
+    assert finished["status"] == "succeeded"
+    assert finished["reserved"] == len(PNG) * 4 + 4096
+    result = api.public_job(finished)
+    assert result["requested_n"] == 1 and result["actual_n"] == 4
+    assert len(result["data"]) == 4
+    assert all(item["url"].startswith(core.PUBLIC + "/media/") for item in result["data"])
+
+
+@pytest.mark.parametrize("requested,actual", [(1, 4), (4, 1), (1, 10)])
+def test_base64_accepts_actual_count(requested, actual):
+    job = make_job(n=requested)["id"]
+    set_response(job, [{"b64_json": base64.b64encode(PNG).decode()}] * actual)
+    tasks.prepare_impl(job)
+    assert row(job)["status"] == "succeeded"
+    assert row(job)["n"] == requested and row(job)["actual_n"] == actual
+    assert len(api.public_job(row(job))["data"]) == actual
+
+
+@pytest.mark.parametrize("items,code,stage", [
+    ([], "missing_upstream_image", "data"),
+    ([{}], "missing_upstream_image", "data[0]"),
+    ([{"url": "https://user:secret@example.test/private"}], "invalid_image_url", "data[0].url"),
+    ([{"b64_json": "%%%="}], "invalid_image_base64", "data[0].b64_json"),
+    ([{"b64_json": base64.b64encode(b"not an image").decode()}], "unsupported_image_type", "data[0].b64_json"),
+    ([{"url": "https://upstream.example/x.png"}] * 11, "upstream_image_count_exceeded", "image_count"),
+])
+def test_specific_errors_without_private_response_data(items, code, stage, caplog):
+    job = make_job()["id"]
+    set_response(job, items)
+    tasks.prepare_impl(job)
+    result = api.public_job(row(job))
+    assert result["error"]["code"] == code
+    assert result["error"]["details"]["stage"] == stage
+    assert "secret" not in json.dumps(result) and "secret" not in caplog.text
+    assert "example.test" not in caplog.text
+
+
+def test_expansion_capacity_failure_does_not_commit_images(monkeypatch):
+    job = make_job()["id"]
+    original = row(job)["reserved"]
+    set_response(job, [{"url": "https://upstream.example/x.png"}] * 4)
+    monkeypatch.setattr(core, "QUOTA", original)
+    tasks.prepare_impl(job)
+    assert row(job)["error"] == "image_storage_capacity_reached"
+    assert row(job)["reserved"] == original
+    with core.db() as connection:
+        assert connection.execute("SELECT COUNT(*) FROM images WHERE job=?", (job,)).fetchone()[0] == 0
+
+
+def test_failed_multi_image_commit_reclaims_every_moved_file(monkeypatch):
+    job = make_job()["id"]
+    set_response(job, [{"b64_json": base64.b64encode(PNG).decode()}] * 4)
+    original = tasks.os.replace
+    calls = 0
+    def interrupted(source, target):
+        nonlocal calls
+        calls += 1
+        if calls == 3:
+            raise OSError("interrupted image commit")
+        return original(source, target)
+    monkeypatch.setattr(tasks.os, "replace", interrupted)
+    tasks.prepare_impl(job)
+    assert row(job)["status"] == "failed"
+    assert core.media_path(core.image_id(job, 1)).exists()
+    tasks.reclaim_failed()
+    assert not list((core.DATA / "media").iterdir())
+    assert not list((core.DATA / "staging").iterdir())
+
+
+def test_expansion_checks_free_disk(monkeypatch):
+    job = make_job()["id"]
+    set_response(job, [{"url": "https://upstream.example/x.png"}] * 4)
+    monkeypatch.setattr(core.shutil, "disk_usage", lambda _: SimpleNamespace(free=0))
+    tasks.prepare_impl(job)
+    assert row(job)["error"] == "insufficient_disk_space"
+
+
+def test_expansions_serialize_quota_admission(monkeypatch):
+    identifiers = [make_job("job-one")["id"], make_job("job-two")["id"]]
+    original = row(identifiers[0])["reserved"]
+    monkeypatch.setattr(core, "QUOTA", original * 3)
+    with core.db() as connection:
+        connection.execute("UPDATE jobs SET status='preparing',claim='test'")
+    def expand(identifier):
+        try:
+            core.expand_reservation(identifier, "test", original * 2)
+            return True
+        except core.AdmissionError:
+            return False
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        assert sorted(pool.map(expand, identifiers)) == [False, True]
+    with core.db() as connection:
+        assert connection.execute("SELECT SUM(reserved) FROM jobs").fetchone()[0] == core.QUOTA
+
+
+def test_multi_image_save_retry_never_regenerates(monkeypatch):
+    job = make_job()["id"]
+    set_response(job, [{"url": f"https://upstream.example/{i}.png"} for i in range(4)])
+    tasks.prepare_impl(job)
+    monkeypatch.setattr(tasks, "download", fake_download)
+    for i in range(3):
+        tasks.save_image.call_local(core.image_id(job, i))
+    def broken(*args):
+        raise RuntimeError("download failed")
+    monkeypatch.setattr(tasks, "download", broken)
+    last = core.image_id(job, 3)
+    for _ in range(3):
+        with core.db() as connection:
+            connection.execute("UPDATE images SET next_attempt=0 WHERE id=?", (last,))
+        tasks.save_image.call_local(last)
+    assert row(job)["status"] == "save_failed"
+    client = TestClient(api.app)
+    response = client.post(f"/async-images/v1/tasks/{job}/retry-save", headers={
+        "Authorization": "Bearer " + TOKEN, "X-Real-IP": "127.0.0.1",
+    })
+    assert response.status_code == 202
+    monkeypatch.setattr(tasks, "download", fake_download)
+    tasks.save_image.call_local(last)
+    assert row(job)["status"] == "succeeded"
+    assert len(api.public_job(row(job))["data"]) == 4
+
+
+@pytest.mark.parametrize("streaming", [False, True])
+def test_sync_accepts_four_urls_with_empty_base64(monkeypatch, streaming):
+    calls = mock_sync_upstream(monkeypatch, {"data": [
+        {"url": f"https://upstream.example/{i}.png", "b64_json": ""} for i in range(4)
+    ]})
+    payload = {"model": "mock", "prompt": "x", "n": 1}
+    if streaming:
+        client = TestClient(api.app)
+        result = client.post("/v1/images/generations", json=payload, headers={
+            "Authorization": "Bearer " + TOKEN, "X-Real-IP": "127.0.0.1",
+        })
+        assert result.status_code == 200
+        output = result.json()
+    else:
+        output = sync.generate_sync(owner, TOKEN, "127.0.0.1", payload)
+    assert len(calls) == 1 and len(output["data"]) == 4
+    assert all(item["url"].startswith(core.PUBLIC + "/media/") for item in output["data"])
+    with core.db() as connection:
+        job = dict(connection.execute("SELECT * FROM jobs").fetchone())
+    assert job["n"] == 1 and job["actual_n"] == 4
