# ===========================================
# 核心配置
# ===========================================

# 上游 API 密钥（必填），支持多 key 逗号分隔轮询
MODEL_API_KEY=sk-xxxx

# 上游 API 地址（可选）
# Default: https://zhangyuapi.com
BASE_URL=

# 模型列表接口（可选）
# Default: https://zhangyuapi.com/v1
MODELS_API_URL=

# ===========================================
# New API 账号接入（可选）
# ===========================================

# 启用后，聊天使用登录用户选定的令牌，不回退公共 MODEL_API_KEY。
# 服务端访问地址，只填写 origin，不带 /v1；同机可用内网地址。
NEW_API_BASE_URL=

# Optional image-service origin for account mode; generations/edits/variations
# use it while account, chat, and model discovery keep NEW_API_BASE_URL.
# Example: http://image-async:8000. Leave empty to use NEW_API_BASE_URL.
NEW_API_IMAGE_BASE_URL=

# New API 对外地址，用于账号中心链接及 refresh/logout 的 Origin。
# 内网访问时必须填写公开 HTTPS origin，例如 https://zhangyuapi.com。
NEW_API_PUBLIC_URL=

# Async image/video gateway origin. Defaults to NEW_API_PUBLIC_URL because
# /async-images and /async-videos are gateway routes, not New API /v1 routes.
NEW_API_ASYNC_BASE_URL=

# 聊天站独立加密密钥，至少 32 字符。不要复制 New API 的 SESSION_SECRET。
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEW_API_SESSION_SECRET=

# 生产环境必须配置；仅用于聊天站自己的加密会话键，不修改 New API 的数据。
# 例如 redis://:密码@redis:6379/2。开发环境可留空，重启后需要重新登录。
NEW_API_REDIS_URL=

# 仅在应用只能由可信反向代理访问，且代理覆盖 X-Real-IP 时设 true。
# New API 也需信任该代理链，避免全部用户共用 BFF 的 IP 限流。
NEW_API_TRUST_PROXY=false
# 传统模式使用可信反向代理提供的 X-Real-IP；必须禁止直连并覆盖客户端同名头。
# 未启用时匿名请求共用保守的限流桶，章鱼账号模式始终按已验证账号计数。
TRUST_PROXY=false

# ===========================================
# 访问控制
# ===========================================

# 站点访问密码（可选）
# 设置后需要输入密码才能访问站点
ACCESS_PASSWORD=

# 允许的来源域名 - 用于 CORS 配置（可选）
# 如果不设置，将使用 VERCEL_URL 或 localhost:3000
ALLOWED_ORIGIN=

# ===========================================
# 功能开关
# ===========================================

# 禁用 GPT-4（可选），设为 1
DISABLE_GPT4=

# 隐藏用户 API Key 输入框（可选），设为 1
HIDE_USER_API_KEY=

# 允许用户查询余额（可选），设为 1
ENABLE_BALANCE_QUERY=

# 禁止从 URL 解析设置（可选），设为 1
DISABLE_FAST_LINK=

# 自定义模型列表（可选）
# 使用 + 添加，- 隐藏，name=displayName 自定义名称，逗号分隔
CUSTOM_MODELS=

# 默认模型（可选）
DEFAULT_MODEL=

# 启用 MCP 功能（可选）
# 设为 "true" 启用
ENABLE_MCP=
# MCP 管理会启动服务器进程，仅允许显式列出的章鱼后台管理员账号 ID。
# 留空时拒绝所有 MCP 操作；普通登录用户不能添加或调用服务器 MCP。
MCP_ADMIN_USER_IDS=

# ===========================================
# 网络代理
# ===========================================

# 通过代理出网（可选，Docker 部署时使用）
PROXY_URL=

# ===========================================
# 速率限制（可选）
# ===========================================

ENABLE_RATE_LIMIT=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60
# Task status GETs use a separate account/IP budget from paid submissions.
MODEL_QUERY_RATE_LIMIT_MAX=600
MODEL_QUERY_RATE_LIMIT_WINDOW=60

# 技能联网检索（只读检索，不保存用户查询）
# 可选：技能目录的 GitHub 原始 JSON 地址（构建时配置；默认 octopus-skills 公开仓库）
NEXT_PUBLIC_SKILL_CATALOG_URL=
# Tavily search is billed through New API using the signed-in user's token.
# Requires NEW_API_BASE_URL and a search channel with per-request pricing.
# Defaults to tavily-quick; set tavily-deep for advanced search.
# See deploy/tavily/README.md for adapter deployment and fixed per-request pricing.
SKILLS_WEB_SEARCH_MODEL=tavily-quick
# 可选：Crossref 联系邮箱，提供后使用其 polite pool
SKILLS_CROSSREF_MAILTO=

# ===========================================
# API 路由说明
# ===========================================

# 标准路径（推荐）
# /api/v1/chat/completions → https://zhangyuapi.com/v1/chat/completions
# /api/v1/images/generations → https://zhangyuapi.com/v1/images/generations
