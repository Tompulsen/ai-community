+def safe_video_message(value, token=""):
+    if not isinstance(value, str) or not value.strip() or len(value) > 4096:
+        return None
+    if re.search(r"<[^>]+>|[{}]", value):
+        return None
+    if token:
+        value = value.replace(token, "[redacted]")
+    hostname = urlsplit(UPSTREAM).hostname
+    if hostname:
+        value = re.sub(re.escape(hostname), "[redacted]", value, flags=re.I)
+    value = re.sub(r"https?://[^\s<>\"']+|data:[^\s]+", "[redacted]", value, flags=re.I)
+    value = re.sub(r"\b(?:[a-z0-9-]+\.)+(?:com|net|org|io|ai|cn|dev|app|cloud|example|internal|local)\b(?::\d+)?",
+                   "[redacted]", value, flags=re.I)
+    value = re.sub(r"\b(?:\d{1,3}\.){3}\d{1,3}\b|\[[0-9a-f:]{3,}\]", "[redacted]", value, flags=re.I)
+    value = re.sub(r"\bBearer\s+\S+|\bsk-[A-Za-z0-9_-]+|\b(?:api[_ -]?key|access[_ -]?token|secret|password)\s*[:=]\s*\S+",
+                   "[redacted]", value, flags=re.I)
+    value = re.sub(r"\b[A-Za-z0-9_+/-]{40,}={0,2}", "[redacted]", value)
+    value = re.sub(r"\b(?:openai|anthropic|azure|volcengine|bytedance|replicate|siliconflow)\b",
+                   "[redacted]", value, flags=re.I)
+    value = re.sub(r"(?:provider|channel|upstream|供应商|渠道)\s*[:=]\s*[^,;\n]+", "[redacted]", value, flags=re.I)
+    return " ".join(re.sub(r"[\x00-\x1f\x7f]", " ", value).split())[:512] or None
+
+
+def structured_video_error(result, token=""):
+    if not isinstance(result, dict):
+        return {}
+    source = result.get("error", result)
+    if not isinstance(source, dict):
+        return {}
+    details = {}
+    message = source.get("message")
+    if (source.get("code") == "fail_to_fetch_task" and isinstance(message, str)
+            and re.match(r"^Video submission failed \(HTTP [1-5]\d{2}\)(?:: |$)", message)):
+        message = safe_video_message(message, token)
+        if message:
+            details.update(message=message, upstream_code="fail_to_fetch_task")
+        return details
+    validation = source.get("detail")
+    if isinstance(validation, list):
+        reasons = {
+            "missing": "Field required", "extra_forbidden": "Extra inputs are not permitted",
+            "string_type": "Input should be a valid string", "int_type": "Input should be a valid integer",
+            "int_parsing": "Input should be a valid integer", "float_type": "Input should be a valid number",
+            "float_parsing": "Input should be a valid number", "bool_type": "Input should be a valid boolean",
+            "bool_parsing": "Input should be a valid boolean", "list_type": "Input should be a valid list",
+            "dict_type": "Input should be a valid dictionary", "literal_error": "Invalid value",
+            "enum": "Invalid value", "value_error": "Invalid value", "greater_than": "Out of range",
+            "greater_than_equal": "Out of range", "less_than": "Out of range", "less_than_equal": "Out of range",
+            "string_too_long": "Invalid length", "string_too_short": "Invalid length",
+        }
+        fields = {"body", "query", "path", "model", "prompt", "seconds", "duration", "duration_seconds", "size",
+                  "resolution", "resolution_name", "aspect_ratio", "aspectRatio", "ratio", "video_reference_frame_mode",
+                  "frame_rate", "generate_audio", "generation_options", "input_images", "input_videos", "input_audios",
+                  "reference_images", "reference_videos", "reference_audios", "input_reference", "first_frame",
+                  "last_frame", "image", "images", "content", "metadata"}
+        messages = []
+        for item in validation[:4]:
+            if not isinstance(item, dict):
+                continue
+            reason = reasons.get(item["type"]) if isinstance(item.get("type"), str) else None
+            if not reason and item.get("msg") in reasons.values():
+                reason = item["msg"]
+            if not reason:
+                continue
+            loc = item.get("loc", [])
+            if not isinstance(loc, list):
+                continue
+            location = ".".join(str(part) for part in loc[:8]
+                                if (isinstance(part, str) and part in fields)
+                                or (type(part) is int and 0 <= part <= 128))
+            messages.append((location + ": " if location else "") + reason)
+        message = safe_video_message("; ".join(messages), token)
+        if message:
+            details["message"] = message
+    return details
+
+
+async def response_video_error(response, code, stage):
+    details = {"status": response.status_code, "stage": stage}
+    media_type = response.headers.get("content-type", "").split(";", 1)[0].strip().lower()
+    if media_type == "application/json" or media_type.endswith("+json"):
+        try:
+            async with asyncio.timeout(5):
+                body = bytearray()
+                async for chunk in response.aiter_bytes(4096):
+                    body.extend(chunk)
+                    if len(body) > 16 * 1024:
+                        return VideoError(code, details)
+                token = response.request.headers.get("authorization", "").removeprefix("Bearer ")
+                details.update(structured_video_error(json.loads(body), token))
+        except (httpx.HTTPError, TimeoutError, ValueError, UnicodeError):
+            pass
+    return VideoError(code, details)
 
 
